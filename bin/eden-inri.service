[Unit]
Description=Eden Integrated Network Resource Identity Service
After=network-online.target

[Service]
Type=forking
RemainAfterExit=yes
WorkingDirectory=/home/lubos/homelab/apps/eden/eden-inri
ExecStart=/usr/bin/podman-compose up -d --force-recreate
ExecStop=/usr/bin/podman-compose down
Restart=on-failure

[Install]
WantedBy=default.target